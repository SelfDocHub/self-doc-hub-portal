# Base URL of docs-hub, reachable from the portal container (no trailing slash).
NUXT_DOCS_HUB_URL=http://host.docker.internal:8080
# Optional: force this domain instead of the request Host (handy for local development).
NUXT_DOMAIN_OVERRIDE=
# true only behind a trusted reverse proxy that sets X-Forwarded-Host.
NUXT_TRUST_PROXY=false
# Optional public origin for sitemap.xml, e.g. https://docs.example.com (default: taken from the request).
NUXT_SITE_ORIGIN=
# Port published on the host by docker compose.
PORTAL_PORT=3000
